{
  "version": 2,
  "routes": [
    {
      "src": "/(.*)",
      "headers": {
        "X-Content-Type-Options": "nosniff",
        "X-Frame-Options": "SAMEORIGIN",
        "Referrer-Policy": "strict-origin-when-cross-origin",
        "Permissions-Policy": "camera=(), microphone=(), geolocation=()",
        "Content-Security-Policy": "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://fonts.googleapis.com https://www.clarity.ms https://clarity.ms https://www.googletagmanager.com https://cdn.jsdelivr.net https://snap.licdn.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: https:; frame-src https://calendly.com; connect-src 'self' https://vitals.vercel-insights.com https://www.clarity.ms https://region1.google-analytics.com https://px.ads.linkedin.com https://snap.licdn.com; object-src 'none'"
      },
      "continue": true
    },
    { "src": "/\\.well-known/mcp-registry-auth", "headers": { "Content-Type": "text/plain; charset=utf-8" }, "dest": "/.well-known/mcp-registry-auth" },
